# OpenAI API Key (required for LLM chat functionality)
OPENAI_API_KEY=your-openai-api-key-here

# Massive (Polygon.io) API Key (optional, for real market data)
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# LLM Mock Mode (optional, set to "true" for deterministic mock responses during testing)
LLM_MOCK=false
